{
  "manifest_version": 3,
  "name": "AI图图 · Gemini 页面探测",
  "version": "0.1.0",
  "description": "收集 Gemini 网页的输入框、上传、发送、出图等页面结构，用来开发 AI图图 插件。不收集聊天内容。",
  "content_scripts": [
    {
      "matches": ["https://gemini.google.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "background": { "service_worker": "background.js" },
  "host_permissions": ["https://gemini.google.com/*", "https://*.googleusercontent.com/*"]
}
