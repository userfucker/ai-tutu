{
  "manifest_version": 3,
  "name": "AI图图 · 电商作图助手（Gemini / Copilot）",
  "version": "0.8.1",
  "description": "在 Gemini / Copilot 网页版里批量做抠白底图 / 产品精修；也可以连接 AI图图 工作台（网页版），替工作台在 Gemini / Copilot 里写文字、看图、画图。Copilot 请用谷歌浏览器（Edge 不允许插件进 Copilot）。",
  "permissions": [
    "storage",
    "alarms"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://gemini.google.com/*",
        "https://copilot.com/*",
        "https://*.copilot.com/*",
        "https://copilot.microsoft.com/*"
      ],
      "js": [
        "content/guard.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://gemini.google.com/*"
      ],
      "js": [
        "lib/imagekit.js",
        "content/common.js",
        "content/gemini.js",
        "content/panel.js",
        "content/workbench-runner.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://copilot.com/*",
        "https://*.copilot.com/*",
        "https://copilot.microsoft.com/*"
      ],
      "js": [
        "lib/imagekit.js",
        "content/common.js",
        "content/copilot.js",
        "content/panel.js",
        "content/workbench-runner.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "https://gemini.google.com/*",
    "https://*.googleusercontent.com/*",
    "https://*.google.com/*",
    "https://*.gstatic.com/*",
    "https://copilot.com/*",
    "https://*.copilot.com/*",
    "https://copilot.microsoft.com/*",
    "https://*.bing.com/*",
    "https://*.microsoft.com/*"
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  }
}
