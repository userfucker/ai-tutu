{
  "manifest_version": 3,
  "name": "AI图图 · Gemini 电商作图助手",
  "version": "0.1.3",
  "description": "在 Gemini 网页版里批量做抠白底图 / 产品精修：右侧面板加图、自动贴图发提示词、取回原图后处理，单张或打包下载。",
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://gemini.google.com/*"
      ],
      "js": [
        "lib/imagekit.js",
        "content/gemini.js",
        "content/panel.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "https://gemini.google.com/*",
    "https://*.googleusercontent.com/*",
    "https://*.google.com/*",
    "https://*.gstatic.com/*"
  ]
}
